# ═══════════════════════════════════════════════════════════════════════════════
# LOCAL DEVELOPMENT ONLY
# These defaults are for the local docker-compose stack. Do NOT use them in
# production — see docs/operations/security-hardening.md before exposing any port.
# ═══════════════════════════════════════════════════════════════════════════════
POSTGRES_USER=wiki
POSTGRES_PASSWORD=wiki
POSTGRES_DB=wiki
DATABASE_URL=postgresql+psycopg://wiki:wiki@postgres:5432/wiki
TEMPORAL_HOST=temporal:7233
LITELLM_BASE_URL=http://localhost:4001
LITELLM_API_KEY=sk-local
LITELLM_MASTER_KEY=sk-local
OBJECT_STORE_PATH=/data/objects
WIKI_MODEL=wiki-default
# Vision transcription of PDF/image uploads. The alias must point at a
# vision-capable backing model (see deploy/litellm/litellm_config.yaml).
WIKI_VISION_MODEL=wiki-vision
# PDFs with more pages than this are rejected at upload.
MAX_PDF_PAGES=50

# LLM gateway (any OpenAI-compatible provider: OpenAI, Azure, self-hosted, …).
# Required for real LLM calls. Default WIKI_MODEL=wiki-default routes here.
LLM_GATEWAY_BASE_URL=https://api.openai.com/v1
LLM_GATEWAY_KEY=replace-me

# Optional Anthropic-native gateway. Required only when WIKI_MODEL=wiki-anthropic.
LLM_ANTHROPIC_BASE_URL=https://api.anthropic.com
LLM_ANTHROPIC_KEY=replace-me

# Logging level (DEBUG|INFO|WARNING|ERROR)
LOG_LEVEL=INFO
# LLM client resilience (passed to litellm)
LLM_NUM_RETRIES=2
LLM_TIMEOUT_SECONDS=60
# Embeddings power vector search + the /lint/related hint. They are best-effort:
# a failed/rate-limited embed never fails ingest, and search falls back to
# keyword-only. Set false to skip embedding entirely.
EMBEDDINGS_ENABLED=true

# Confluence connector (M5) — a Confluence API token + the user email it belongs to.
# Leave blank to disable the connector; the sync endpoint 500s with a clear hint if unset.
CONFLUENCE_API_TOKEN=
CONFLUENCE_USER_EMAIL=

# ── JWT identity (M7 + web SSO) — off by default (dev X-User-* seam) ─────────
# Flip JWT_ENABLED=true only after grants exist for real users (logged-in ≠
# authorized: a JWT principal has no roles until RoleGrant rows cover it).
JWT_ENABLED=false
# Trusted issuers (JSON array). Each entry: issuer + jwks_url required;
# audience, algorithms, identity_claim optional. Example (single line):
# JWT_TRUSTED_ISSUERS=[{"issuer":"https://devportal.example","jwks_url":"https://devportal.example/.well-known/jwks.json","audience":"k7e"}]
JWT_TRUSTED_ISSUERS=
# Legacy single-issuer shorthand — folds into the trusted list (an empty
# JWT_ISSUER keeps its historical wildcard, no-iss-check semantics).
JWT_ISSUER=
JWT_JWKS_URL=
JWT_AUDIENCE=
# Claim used as Principal.user_id (default sub). Must yield values matching
# Membership.user_id / RoleGrant.principal_id; per-issuer identity_claim wins.
JWT_IDENTITY_CLAIM=sub
# HS256 shared secret for local smoke without an IdP. Honored ONLY when
# ENV=dev; ignored (with a warning) everywhere else.
JWT_DEV_SECRET=

# ── Web (SPA) auth — baked into the bundle at BUILD time by Vite ─────────────
# dev (default): no login UI, sends X-User-Id: dev. password: native
# email+password login (self-issued session).
VITE_AUTH_MODE=dev
# Must mirror JWT_IDENTITY_CLAIM so the UI's self-identity checks match.
VITE_IDENTITY_CLAIM=sub
